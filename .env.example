# =====================================================
# ExamConnect Environment Configuration Example
# Copy to .env and fill in secure values before running
# =====================================================

# PostgreSQL Database
POSTGRES_DB=examconnect
POSTGRES_USER=examconnect
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://examconnect:change_me_strong_password@localhost:5432/examconnect

# Redis (Worker & Job Scheduler)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# API Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Frontend & CORS
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Security (set true in HTTPS production deployments)
COOKIE_SECURE=false

# Outbound Email (SMTP) — Required for live Forgot Password emails in production
# In development, if left blank, reset emails are captured to apps/api/.dev-mailbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ExamConnect Security <no-reply@example.com>"

# Redis extras (REDIS_URL overrides host/port when set; rediss:// enables TLS)
REDIS_URL=
REDIS_TLS=false

# Web -> API proxy used by the Next.js server, and app base URL for email links
API_INTERNAL_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-off admin bootstrap (pnpm --filter @examconnect/api bootstrap:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
