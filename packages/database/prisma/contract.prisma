model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime

  studentProfile StudentProfile?
}

model StudentProfile {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  firstName        String
  lastName         String?
  dateOfBirth      DateTime?
  gender           String?
  state            String?
  category         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime

  user             User              @relation(fields:[userId], references:[id])
  educationRecords EducationRecord[]
}

model EducationRecord {
  id                Int            @id @default(autoincrement())
  studentProfileId  Int
  qualification     String
  courseName        String?
  institutionName   String?
  boardOrUniversity String?
  passingYear       Int?
  percentage        Float?
  stream            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime

  studentProfile    StudentProfile @relation(fields:[studentProfileId], references:[id])
}

model Exam {
  id              Int      @id @default(autoincrement())
  name            String
  conductingBody  String
  examType        String?
  description     String?
  officialWebsite String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  eligibilityRules EligibilityRule[]
}

model EligibilityRule {
  id          Int      @id @default(autoincrement())
  examId      Int
  ruleType    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  exam     Exam                     @relation(fields: [examId], references: [id])
  versions EligibilityRuleVersion[]

  @@index([examId])
}

model EligibilityRuleVersion {
  id                   Int      @id @default(autoincrement())
  eligibilityRuleId    Int
  notificationSourceId Int?
  versionNumber        Int
  status               String
  conditionField       String
  operator             String
  expectedValue        String
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime

  eligibilityRule    EligibilityRule     @relation(fields: [eligibilityRuleId], references: [id])
  notificationSource NotificationSource?  @relation(fields: [notificationSourceId], references: [id])

  @@index([eligibilityRuleId])
  @@index([notificationSourceId])
}

model NotificationSource {
  id                    Int      @id @default(autoincrement())
  organization          String
  notificationTitle     String
  notificationDate      DateTime?
  officialUrl            String
  notificationIdentifier String?
  dateImported          DateTime @default(now())
  lastVerifiedAt        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  eligibilityRuleVersions EligibilityRuleVersion[]

  @@index([organization])
}