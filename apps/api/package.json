    "seed:exams": "tsx ../../packages/database/src/seed-exams.ts"
  },
  "dependencies": {
    "@examconnect/database": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "argon2": "^0.45.1",
    "fastify": "^5.0.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}