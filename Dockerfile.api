FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/package.json apps/api/tsconfig.json ./apps/api/

RUN pnpm install --frozen-lockfile --filter @examconnect/api... --filter @examconnect/database...

COPY apps/api/src ./apps/api/src

ENV NODE_ENV=production
ENV HOST=0.0.0.0
EXPOSE 4000

CMD ["sh", "-c", "pnpm --filter @examconnect/database exec prisma db migrate && pnpm --filter @examconnect/api seed:exams && pnpm --filter @examconnect/api start"]